    ann:familyId "dependency/power" ;
    rdfs:label "dependency/power" .

sahr:attributeRelation a sahr:RelationFamily ;
    ann:familyId "attribute" ;
    rdfs:label "attribute" .

sahr:temporalRelation a sahr:RelationFamily ;
    ann:familyId "temporal" ;
