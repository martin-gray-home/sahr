@prefix sahr: <https://sahr.ai/ontology/canonical#> .
@prefix ann: <https://sahr.ai/ontology/annotations#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://sahr.ai/ontology/canonical>
    a owl:Ontology ;
    rdfs:label "SAHR Canonical Semantic Families" .

ann:familyId a owl:AnnotationProperty .

sahr:ConceptFamily a owl:Class ;
    rdfs:label "Concept Family" .

sahr:RelationFamily a owl:Class ;
    rdfs:label "Relation Family" .

sahr:FrameFamily a owl:Class ;
    rdfs:label "Frame Family" .

sahr:RoleType a owl:Class ;
    rdfs:label "Role Type" .

sahr:personLike a sahr:ConceptFamily ;
    ann:familyId "person-like" ;
    rdfs:label "person-like" ;
    rdfs:comment "human or human-equivalent agents" .

sahr:animate a sahr:ConceptFamily ;
    ann:familyId "animate" ;
    rdfs:label "animate" .

